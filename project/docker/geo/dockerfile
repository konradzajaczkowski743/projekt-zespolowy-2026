# ─────────────────────────────────────────────
# Stage 1: model downloader
# ─────────────────────────────────────────────
FROM python:3.12-slim AS model-downloader

WORKDIR /models

RUN pip install --no-cache-dir huggingface_hub==0.23.*

RUN --mount=type=cache,target=/root/.cache/huggingface \
    python - <<'EOF'
from huggingface_hub import snapshot_download

models = [
    "mmgyorke/vit-world-landmarks",
    "corenet-community/places365-224x224-vit-base",
]

for repo_id in models:
    snapshot_download(
        repo_id=repo_id,
        local_dir=f"/models/{repo_id.replace('/', '__')}",
        local_dir_use_symlinks=False,
        ignore_patterns=["*.msgpack", "flax_model*", "tf_model*", "rust_model*"],
    )
    print(f"[OK] {repo_id}")
EOF

# ─────────────────────────────────────────────
# Stage 2: runtime
# ─────────────────────────────────────────────
FROM python:3.12-slim AS runtime

LABEL maintainer="wiktor-docker"
LABEL description="Geolocation verification module — landmark + scene classification"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --from=model-downloader /models /app/models

COPY . .

ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1
ENV HF_HOME=/app/models/.cache

ENV MODEL_LANDMARKS_PATH=/app/models/mmgyorke__vit-world-landmarks
ENV MODEL_PLACES365_PATH=/app/models/corenet-community__places365-224x224-vit-base

ENV PHOTON_HOST=photon
ENV PHOTON_PORT=2322

ENV OLLAMA_HOST=gemma
ENV OLLAMA_PORT=11434
ENV OLLAMA_MODEL=gemma4:e2b

CMD ["tail", "-f", "/dev/null"]