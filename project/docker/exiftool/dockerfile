# Alternatywny Dockerfile — Python wrapper zamiast Perl
FROM python:3.12-slim
RUN apt-get update && apt-get install -y exiftool curl && rm -rf /var/lib/apt/lists/*
RUN pip install fastapi uvicorn python-multipart --no-cache-dir
COPY server.py .
EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001"]